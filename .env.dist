# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded automatically for local `serve`/`mock`/probe runs via godotenv.

# --- Target ---
# mock: run against the local `mock` server (default here; credentials below are
#       ignored and dummy values are used). live: hit the real Hyundai Bluelink API.
MODE=mock
# Only needed if the mock runs on a non-default address (see `mock --addr`).
# MOCK_URL=http://localhost:8090

# --- Bluelink EU account (required when MODE=live; ignored when MODE=mock) ---
BLUELINK_USERNAME=you@example.com
BLUELINK_PASSWORD=your-account-password
# Optional: target a specific car. Empty = first vehicle on the account.
BLUELINK_VIN=
# Optional: account PIN (not needed for read-only status).
BLUELINK_PIN=

# --- Polling & scheduling ---
POLL_INTERVAL=45m
FORCE_REFRESH_AT=05:00
FORCE_REFRESH_TZ=Europe/London
FORCE_REFRESH_ONLY_WHEN_PLUGGED_IN=false
READY_FAILURE_THRESHOLD=3
POLL_MAX_RETRIES=3

# --- MQTT ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hyundai-bluelink-mqtt
MQTT_TOPIC_PREFIX=hyundai_bluelink
HA_DISCOVERY_PREFIX=homeassistant
# km | mi — label AND published value for both the Range and Odometer sensors;
# each is converted from whatever unit the API reported it in.
# Note: this is what gets published. Home Assistant re-converts distance sensors
# into its own unit system, so a Metric HA shows a "mi" sensor in km — override the
# unit per entity in the HA entity registry if you need imperial on the dashboard.
DISTANCE_UNIT=km

# --- Tokens ---
# memory (local) | kube (in-cluster). Local dev keeps tokens in-process.
TOKEN_STORE=memory
TOKEN_SECRET_NAME=

# --- Health & logging ---
HEALTH_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
